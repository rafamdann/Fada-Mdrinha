---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Star from '../components/Star.astro';
import ContactCta from '../components/ContactCta.astro';
import { journey, phases, included } from '../data/content';
---
<Base title="O Nosso Método" description="Do primeiro contacto ao acompanhamento depois do serviço: conheça a experiência Fada Madrinha, desenhada para que cada contacto seja memorável.">
  <PageHero tone="gold" title="Não limpamos apenas espaços. Cuidamos das pessoas que vivem neles." text="Forma uma opinião sobre nós muito antes de começarmos a limpar: na rapidez da resposta, na simpatia, na pontualidade. Por isso, desenhámos cada passo." />

  <section class="section" aria-labelledby="j-t">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="j-t" class="reveal">Do primeiro olá ao dia seguinte</h2>
        <p class="reveal" style="--d:1">Oito momentos, um só padrão. As mensagens são as que recebe de nós.</p>
      </div>
      <ol class="journey">
        {journey.map((s, i) => (
          <li class:list={['jstep', 'reveal', { 'jstep--right': i % 2 === 1 }]}>
            <span class="jstep__n num-dot">{i + 1}</span>
            <div class="jstep__card">
              <p class="jstep__moment">{s.moment}</p>
              <h3>{s.title}</h3>
              <p class="jstep__text">{s.text}</p>
              {s.message && <p class="bubble"><span class="visually-hidden">Mensagem da equipa: </span>{s.message}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-azul" aria-labelledby="f-t">
    <Star style="top:12%;left:8%;--s:30px" color="var(--white)" />
    <div class="wrap">
      <div class="head head--center"><h2 id="f-t" class="reveal">No dia do serviço, cinco fases</h2></div>
      <ol class="phases">
        {phases.map((p, i) => (
          <li class="reveal" style={`--d:${i}`}><span class="num-dot">{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SEMPRE INCLUÍDO -->
  <section class="section" aria-labelledby="inc-title">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="inc-title" class="reveal">Sempre incluído, sem pedir</h2>
        <p class="reveal" style="--d:1">O que recebe em cada visita, seja uma casa ou uma empresa.</p>
      </div>
      <ul class="perks">
        {included.map((p, i) => (
          <li class={`perk perk--${p.tone} reveal`} style={`--d:${i % 3}`}>
            <span class="perk__icon"><Icon name={p.icon} size={28} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-gold gold" aria-labelledby="g-t">
    <Star style="top:18%;right:14%;--s:26px;--t:.6s" />
    <Star style="bottom:20%;left:12%;--s:18px;--t:1.2s" color="var(--pink)" />
    <div class="wrap wrap--narrow center">
      <h2 id="g-t" class="gold__label reveal">O Padrão Ouro</h2>
      <p class="gold__q reveal" style="--d:1">“Se este espaço fosse meu, eu daria este serviço por <span class="swash reveal">terminado</span>?”</p>
      <p class="lede mx-auto reveal" style="--d:2">Existe apenas esta pergunta. Se a resposta for não, o trabalho continua. Porque os clientes não nos contratam só porque limpamos bem: contratam-nos porque sentem que alguém cuidou do seu espaço com o carinho que eles próprios teriam.</p>
    </div>
  </section>

  <ContactCta slot="footer" />
</Base>

<style>
  .journey { position: relative; display: grid; gap: 28px; max-width: 1000px; margin: 0 auto; }
  .journey::before { content: ''; position: absolute; left: 23px; top: 24px; bottom: 24px; width: 3px; border-radius: 3px; background: linear-gradient(var(--pink), var(--gold), var(--blue)); }
  .jstep { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 18px; }
  .jstep__n { position: relative; z-index: 1; background: var(--navy); color: var(--white); }
  .jstep__card { background: var(--white); border-radius: var(--r-lg); padding: 26px 26px 28px; box-shadow: 0 4px 0 var(--line); transition: transform 0.45s var(--bounce); }
  .jstep__card:hover { transform: translateY(-4px) rotate(-0.6deg); }
  .jstep__moment { color: var(--pink-text); font-weight: 600; margin-bottom: 4px; }
  .jstep h3 { margin-bottom: 8px; }
  .jstep__text { color: var(--text-soft); }
  .bubble { margin: 16px 0 0; padding: 14px 18px; background: #dcf5e4; color: #0f3b22; border-radius: 18px 18px 18px 4px; max-width: 44ch; position: relative; }
  @media (min-width: 900px) {
    .journey::before { left: 50%; transform: translateX(-50%); }
    .jstep { grid-template-columns: 1fr 48px 1fr; }
    .jstep__n { grid-column: 2; grid-row: 1; }
    .jstep__card { grid-column: 1; grid-row: 1; }
    .jstep--right .jstep__card { grid-column: 3; }
  }
  .phases { display: grid; gap: 16px; }
  .phases li { background: rgba(255, 255, 255, 0.94); border-radius: var(--r-lg); padding: 26px 24px; }
  .phases .num-dot { background: var(--navy); color: var(--white); }
  .phases li:last-child .num-dot { background: var(--pink); }
  .phases h3 { margin: 16px 0 6px; }
  .phases p { margin: 0; color: var(--text-soft); }
  @media (min-width: 700px) { .phases { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .phases { grid-template-columns: repeat(5, 1fr); } }
  .perks { display: grid; gap: 36px 28px; }
  .perk { text-align: center; padding-inline: 12px; }
  .perk h3 { margin: 18px 0 6px; }
  .perk p { color: var(--text-soft); margin: 0 auto; max-width: 30ch; }
  .perk__icon { display: inline-grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; color: var(--white); transition: transform 0.5s var(--bounce); }
  .perk:hover .perk__icon { transform: rotate(-12deg) scale(1.08); }
  .perk--blue .perk__icon { background: var(--blue); } .perk--pink .perk__icon { background: var(--pink); }
  .perk--gold .perk__icon { background: var(--gold); color: var(--navy); } .perk--deep .perk__icon { background: var(--blue-deep); }
  .perk--plum .perk__icon { background: var(--plum); }
  .perk:nth-child(3n+1) .perk__icon { border-radius: 0 50% 50% 50%; }
  @media (min-width: 640px) { .perks { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .perks { grid-template-columns: repeat(3, 1fr); } }
  .gold { overflow: hidden; }
  .gold__label { font-size: 1.2rem; color: var(--gold-text); }
  .gold__q { font-size: clamp(2rem, 1.3rem + 3vw, 3.8rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.025em; color: var(--navy); margin-bottom: 28px; }
</style>
