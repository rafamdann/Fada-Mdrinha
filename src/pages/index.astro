---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import { site, withBase } from '../config/site';
import { faq } from '../data/content';
import cozinha from '../assets/photos/cozinha.jpg';
import engomar from '../assets/photos/engomar.jpg';

const headline = ['Transformamos', 'espaços.', 'Criamos', 'bem-estar.'];
---
<Base title="Fada Madrinha | Limpeza Profissional em Luanda" description={site.description}>

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <Star style="top:12%;left:4%;--s:28px;--t:0s" />
    <Star style="top:64%;left:46%;--s:18px;--t:.8s" color="var(--pink)" />
    <Star style="top:8%;right:40%;--s:14px;--t:1.6s" color="var(--blue)" />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          {headline.map((w, i) => <span class="hero__word" style={`--i:${i}`}>{i === 3 ? <span class="swash">{w}</span> : w} </span>)}
        </h1>
        <p class="lede hero__lede">Limpeza profissional para casas e empresas em Luanda. Com método, cuidado e a discrição de quem trata o seu espaço como se fosse o nosso.</p>
        <div class="actions hero__actions">
          <a href={withBase('/servicos#como-funciona')} class="btn btn--outline btn--lg">Como funciona</a>
        </div>
        <p class="reassure hero__reassure">{site.replyPromise}</p>
      </div>

      <div class="hero__art" aria-hidden="false">
        <div class="hero__drop hero__drop--a">
          <Picture src={cozinha} formats={['avif', 'webp']} widths={[320, 480, 720]} sizes="(min-width: 960px) 340px, 58vw" alt="Colaboradora da Fada Madrinha, de polo azul, a limpar a bancada de uma cozinha" loading="eager" fetchpriority="high" />
        </div>
        <div class="hero__drop hero__drop--b">
          <Picture src={engomar} formats={['avif', 'webp']} widths={[280, 420, 600]} sizes="(min-width: 960px) 260px, 44vw" alt="Colaboradora a engomar roupa com um sorriso" loading="eager" />
        </div>
        <span class="hero__circle hero__circle--a float" aria-hidden="true"></span>
        <span class="hero__circle hero__circle--b float" style="--t:-3s" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-gold" aria-labelledby="faq-title">
    <div class="wrap wrap--narrow">
      <div class="head head--center">
        <h2 id="faq-title" class="reveal">Perguntas frequentes</h2>
        <p class="reveal" style="--d:1">Se a sua não estiver aqui, pergunte-nos pelo WhatsApp.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <ContactCta slot="footer" />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 6vw, 96px) clamp(64px, 8vw, 120px); background: radial-gradient(circle at 85% 30%, var(--tint-blue) 0, transparent 55%), radial-gradient(circle at 10% 90%, var(--tint-pink) 0, transparent 45%); }
  .hero__grid { display: grid; gap: 48px; align-items: center; }
  .hero__title { font-size: clamp(3rem, 1.6rem + 6vw, 6rem); line-height: 0.98; letter-spacing: -0.035em; margin-bottom: 24px; }
  .hero__word { display: inline-block; }
  .hero__lede { margin-bottom: 32px; }
  .hero__art { position: relative; aspect-ratio: 1; width: min(100%, 560px); justify-self: center; }
  .hero__drop { position: absolute; overflow: hidden; background: var(--blue); }
  .hero__drop :global(picture), .hero__drop :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero__drop--a { left: 0; top: 0; width: 62%; aspect-ratio: 1; border-radius: 0 50% 50% 50%; }
  .hero__drop--a :global(img) { object-position: 38% 30%; }
  .hero__drop--b { right: 0; bottom: 0; width: 50%; aspect-ratio: 1; border-radius: 50% 50% 0 50%; border: 8px solid var(--cream); }
  .hero__drop--b :global(img) { object-position: 50% 16%; }
  .hero__circle { position: absolute; border-radius: 50%; }
  .hero__circle--a { right: 6%; top: 4%; width: 28%; aspect-ratio: 1; background: var(--pink); }
  .hero__circle--b { left: 6%; bottom: 6%; width: 22%; aspect-ratio: 1; background: var(--gold); }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; } }

  @media (prefers-reduced-motion: no-preference) {
    .hero__word { opacity: 0; transform: translateY(0.5em) rotate(4deg); animation: word-in 0.9s var(--bounce) forwards; animation-delay: calc(0.15s + var(--i) * 0.12s); }
    .hero__word .swash::after { transform: skewX(-8deg) scaleX(0); animation: swash-in 0.8s var(--ease) 1s forwards; }
    .hero__lede, .hero__actions, .hero__reassure { opacity: 0; animation: fade-up 0.8s var(--ease) forwards; }
    .hero__lede { animation-delay: 0.7s; } .hero__actions { animation-delay: 0.85s; } .hero__reassure { animation-delay: 1s; }
    .hero__drop--a { animation: pop 0.9s var(--bounce) 0.2s both; }
    .hero__drop--b { animation: pop 0.9s var(--bounce) 0.45s both; }
    }
  @keyframes word-in { to { opacity: 1; transform: none; } }
  @keyframes swash-in { to { transform: skewX(-8deg) scaleX(1); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.6) rotate(-8deg); } to { opacity: 1; transform: none; } }

</style>
