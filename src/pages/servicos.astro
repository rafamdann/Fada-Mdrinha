---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import { waLink, whatsappMessages } from '../config/site';
import { services, faq } from '../data/content';
---
<Base title="Serviços" description="Limpeza residencial, empresarial, higienização especializada, organização de espaços, pós-obra e estofos em Luanda. Veja como trabalhamos em cada serviço.">
  <PageHero tone="blue" title="Seis serviços, o mesmo cuidado" text="Cada serviço é adaptado ao seu espaço e à sua rotina. Diga-nos o que precisa e preparamos uma proposta personalizada, clara e sem letras pequenas.">
    <nav class="jump reveal" style="--d:2" aria-label="Ir para o serviço">
      {services.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
  </PageHero>

  {services.map((s, i) => (
    <section id={s.id} class:list={['section', 'svc', `svc--${s.tone}`, { 'svc--alt': i % 2 === 1 }]} aria-labelledby={`${s.id}-t`}>
      <div class="wrap svc__grid">
        <div class="svc__badge reveal" aria-hidden="true">
          <span class="svc__blob"><Icon name={s.icon} size={72} stroke={1.5} /></span>
        </div>
        <div class="svc__body">
          <h2 id={`${s.id}-t`} class="reveal">{s.title}</h2>
          <p class="svc__short reveal" style="--d:1">{s.short}</p>
          <p class="svc__long reveal" style="--d:2">{s.long}</p>
          <h3 class="svc__how reveal" style="--d:3">Como trabalhamos</h3>
          <ol class="svc__steps">
            {s.steps.map((st, k) => <li class="reveal" style={`--d:${k + 3}`}><span class="num-dot">{k + 1}</span><span>{st}</span></li>)}
          </ol>
          <a href={waLink(whatsappMessages.servico(s.title))} class="btn btn--lg reveal" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir orçamento</a>
        </div>
      </div>
    </section>
  ))}

  <section class="section bg-gold" aria-labelledby="faq-t">
    <div class="wrap wrap--narrow">
      <div class="head head--center"><h2 id="faq-t" class="reveal">Perguntas frequentes</h2></div>
      <Faq items={faq} />
    </div>
  </section>

  <ContactCta slot="footer" title="Qual é o seu espaço?" />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .jump a { display: inline-flex; align-items: center; min-height: 46px; padding: 0 1.1rem; border-radius: var(--r-pill); background: var(--white); color: var(--navy); font-weight: 500; text-decoration: none; border: 2px solid transparent; transition: transform 0.35s var(--bounce), border-color 0.2s; }
  .jump a:hover { transform: translateY(-3px); border-color: var(--pink); color: var(--navy); }
  .svc { scroll-margin-top: var(--header-h); }
  .svc--alt { background: var(--white); }
  .svc__grid { display: grid; gap: 36px; align-items: center; }
  .svc__badge { display: flex; justify-content: center; }
  .svc__blob { display: grid; place-items: center; width: clamp(180px, 26vw, 300px); aspect-ratio: 1; border-radius: 0 50% 50% 50%; color: var(--white); transition: transform 0.6s var(--bounce); }
  .svc:hover .svc__blob { transform: rotate(-8deg) scale(1.04); }
  .svc--alt .svc__blob { border-radius: 50% 50% 0 50%; }
  .svc--blue .svc__blob { background: var(--blue); } .svc--deep .svc__blob { background: var(--blue-deep); } .svc--pink .svc__blob { background: var(--pink); }
  .svc--gold .svc__blob { background: var(--gold); color: var(--navy); } .svc--plum .svc__blob { background: var(--plum); } .svc--navy .svc__blob { background: var(--navy); }
  .svc__short { font-size: 1.25rem; color: var(--navy); font-weight: 500; }
  .svc__long { color: var(--text-soft); max-width: 58ch; margin-bottom: 28px; }
  .svc__how { font-size: 1.1rem; color: var(--pink-text); margin-bottom: 14px; }
  .svc__steps { display: grid; gap: 12px; margin-bottom: 32px; }
  .svc__steps li { display: flex; align-items: center; gap: 14px; }
  .svc__steps .num-dot { width: 38px; height: 38px; font-size: 1rem; background: var(--tint-blue); color: var(--navy); }
  .svc--alt .svc__steps .num-dot { background: var(--tint-pink); color: var(--pink-text); }
  @media (min-width: 900px) {
    .svc__grid { grid-template-columns: 0.8fr 1.2fr; gap: 72px; }
    .svc--alt .svc__badge { order: 2; }
  }
</style>
