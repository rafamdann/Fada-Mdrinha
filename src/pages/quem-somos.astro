---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import engomar from '../assets/photos/engomar.jpg';
import Icon from '../components/Icon.astro';
import Star from '../components/Star.astro';
import Wave from '../components/Wave.astro';
import ContactCta from '../components/ContactCta.astro';
import { team, values, principles, oath, compare } from '../data/content';
import { withBase } from '../config/site';
---
<Base title="Quem Somos" description="Conheça a história, a missão, os valores e a equipa da Fada Madrinha, limpeza profissional em Luanda com método, cuidado e confiança.">
  <PageHero label="Quem Somos" image={engomar} imageAlt="Colaboradora da Fada Madrinha a engomar roupa com um sorriso" imagePosition="50% 16%" tone="pink" title="Duas amigas, uma crença, uma equipa que cuida" text="A Fada Madrinha nasce de Irina André e Nguelengue Savinona, duas amigas que sempre entenderam que um espaço limpo e arrumado não é um privilégio. É essencial." />

  <section class="section" aria-labelledby="nome-title">
    <div class="wrap wrap--narrow center">
      <h2 id="nome-title" class="reveal">Porquê “Fada Madrinha”?</h2>
      <p class="story reveal" style="--d:1">Assim como na história, a fada madrinha aparece, realiza transformações e melhora tudo sem que ninguém precise de se preocupar com os detalhes. <span class="swash reveal">É exactamente isso que fazemos.</span></p>
      <p class="lede mx-auto reveal" style="--d:2">A ideia nasceu de uma percepção simples: os espaços em Angola precisam de um serviço de limpeza e organização que vá além do básico, com método, com cuidado e com identidade própria.</p>
    </div>
  </section>

  <!-- COMPARAÇÃO -->
  <Wave color="var(--tint-pink)" />
  <section class="section bg-pink compare" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="compare-title" class="reveal">Cansado da limpeza de sempre?</h2>
        <p class="reveal" style="--d:1">Muitas famílias e empresas em Angola conhecem bem estes problemas. Nós nascemos para os resolver.</p>
      </div>
      <div class="compare__grid">
        <div class="compare__col compare__col--old reveal">
          <h3>A limpeza de sempre</h3>
          <ul>
            {compare.others.map((o, i) => <li class="reveal strike" style={`--d:${i + 1}`}><Icon name="x" size={22} stroke={2.6} /><span><span class="strike__t">{o}</span></span></li>)}
          </ul>
        </div>
        <div class="compare__col compare__col--new reveal" style="--d:2">
          <img src={withBase('/logo/mark.png')} width="72" height="72" alt="" class="compare__mark" />
          <h3>Com a Fada Madrinha</h3>
          <ul>
            {compare.us.map((o, i) => <li class="reveal" style={`--d:${i + 2}`}><Icon name="check" size={22} stroke={2.6} /><span>{o}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <Wave color="var(--white)" bg="var(--tint-pink)" flip />

  <section class="section bg-white" aria-labelledby="val-title">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="val-title" class="reveal">Três valores, três cores</h2>
        <p class="reveal" style="--d:1">As cores do nosso símbolo têm significado. Azul para a confiança, dourado para a excelência, rosa para o cuidado.</p>
      </div>
      <ul class="swatches">
        {values.map((v, i) => (
          <li class={`swatch swatch--${v.tone} reveal`} style={`--d:${i}`}>
            <span class="swatch__chip" aria-hidden="true"></span>
            <h3>{v.title}</h3>
            <p>{v.words}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-azul mission" aria-labelledby="mis-title">
    <Star style="top:14%;left:10%;--s:30px" color="var(--white)" />
    <Star style="bottom:16%;right:12%;--s:22px;--t:1s" color="var(--gold)" />
    <div class="wrap wrap--narrow center">
      <h2 id="mis-title" class="reveal">A nossa missão</h2>
      <p class="mission__text reveal" style="--d:1">Organizar e cuidar dos ambientes com excelência, transformando espaços de trabalho e de vida em locais mais produtivos, acolhedores e inspiradores.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="eq-title">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="eq-title" class="reveal">As pessoas por trás da magia</h2>
        <p class="reveal" style="--d:1">Uma equipa pequena, próxima e comprometida com o mesmo padrão em cada serviço.</p>
      </div>
      <ul class="team">
        {team.map((m, i) => m ? (
          <li class="member reveal" style={`--d:${i}`}>
            <div class:list={['member__photo', `member__photo--${i}`, { 'member__photo--empty': !m.photo }]}>
              {m.photo && <Picture src={m.photo} formats={['avif', 'webp']} widths={[280, 420, 560]} sizes="(min-width: 900px) 300px, 70vw" alt={m.alt ?? m.name} />}
            </div>
            <h3>{m.name}</h3>
            <p class="member__role">{m.role}</p>
            <p class="member__bio">{m.bio}</p>
          </li>
        ) : (
          <li class="member reveal" style={`--d:${i}`} aria-hidden="true">
            <div class={`member__photo member__photo--${i} member__photo--empty`}></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Wave color="var(--tint-pink)" />
  <section class="section bg-pink" aria-labelledby="pr-title">
    <div class="wrap">
      <div class="head head--center">
        <h2 id="pr-title" class="reveal">O que cada Fada promete</h2>
        <p class="reveal" style="--d:1">Seis dos princípios que orientam a nossa equipa todos os dias.</p>
      </div>
      <ul class="principles">
        {principles.map((p, i) => (
          <li class="reveal" style={`--d:${i % 3}`}><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ul>
      <blockquote class="oath reveal">
        <img src={withBase('/fairy/fada.png')} width="331" height="404" alt="" class="oath__fairy" />
        <p>{oath}</p>
        <footer>O Juramento Fada Madrinha, feito por cada colaborador no fim da integração</footer>
      </blockquote>
    </div>
  </section>

  <ContactCta slot="footer" />
</Base>

<style>
  .story { font-size: clamp(1.4rem, 1.1rem + 1.3vw, 2.2rem); line-height: 1.3; font-weight: 500; color: var(--navy); margin-bottom: 28px; }
  .compare { padding-block: clamp(48px, 6vw, 88px); }
  .compare__grid { display: grid; gap: 24px; max-width: 1000px; margin-inline: auto; }
  .compare__col { border-radius: var(--r-lg); padding: clamp(28px, 4vw, 44px); position: relative; }
  .compare__col h3 { margin-bottom: 20px; }
  .compare__col ul { display: grid; gap: 14px; }
  .compare__col li { display: flex; gap: 12px; align-items: flex-start; font-size: 1.05rem; }
  .compare__col li svg { flex: none; margin-top: 2px; }
  .compare__col--old { background: rgba(255, 255, 255, 0.6); color: var(--text-soft); }
  .compare__col--old h3 { color: var(--text-soft); }
  .compare__col--old svg { color: #b3474f; }
  .compare__col--new { background: var(--white); box-shadow: 0 20px 50px rgba(161, 52, 102, 0.16); }
  .compare__col--new svg { color: var(--white); background: var(--pink); border-radius: 50%; padding: 3px; }
  .compare__mark { position: absolute; top: -28px; right: 24px; width: 72px; height: 72px; }
  /* O risco vive num span inline (o de fora é item flex, logo bloco): clone repete-o em cada linha. */
  .strike__t { --strike: color-mix(in srgb, currentColor 65%, transparent); background: linear-gradient(var(--strike), var(--strike)) no-repeat 0 58% / 0 1px; -webkit-box-decoration-break: clone; box-decoration-break: clone; transition: background-size 0.6s var(--ease); transition-delay: calc(0.3s + var(--d, 0) * 120ms); }
  .strike.is-in .strike__t, html:not(.js) .strike .strike__t { background-size: 100% 1px; }
  @media (min-width: 800px) { .compare__grid { grid-template-columns: 0.9fr 1.1fr; align-items: center; } }
  .swatches { display: grid; gap: 20px; }
  .swatch { border-radius: var(--r-lg); padding: 36px 32px; min-height: 280px; display: flex; flex-direction: column; justify-content: flex-end; color: var(--ink); transition: transform 0.45s var(--bounce); }
  .swatch:hover { transform: translateY(-8px) rotate(-1deg); }
  .swatch h3 { color: var(--ink); font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); margin-bottom: 8px; }
  .swatch p { margin: 0; max-width: 28ch; }
  .swatch__chip { width: 56px; height: 56px; border-radius: 0 50% 50% 50%; background: rgba(255, 255, 255, 0.55); margin-bottom: auto; }
  .swatch--blue { background: var(--blue); } .swatch--gold { background: var(--gold); } .swatch--pink { background: var(--pink); }
  @media (min-width: 800px) { .swatches { grid-template-columns: repeat(3, 1fr); } .swatch { min-height: 340px; } }
  .mission { overflow: hidden; }
  .mission h2 { color: var(--navy); }
  .mission__text { font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.3rem); line-height: 1.3; color: var(--white); font-weight: 600; text-shadow: 0 2px 0 rgba(11, 53, 86, 0.25); }
  .team { display: grid; gap: 48px; }
  .member { text-align: center; }
  .member__photo { width: min(100%, 300px); aspect-ratio: 1; margin: 0 auto 22px; overflow: hidden; transition: transform 0.5s var(--bounce); }
  .member:hover .member__photo { transform: scale(1.04) rotate(-2deg); }
  .member__photo :global(picture), .member__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .member__photo--empty { background: var(--tint-blue); }
  .member__photo--0 { border-radius: 0 50% 50% 50%; } .member__photo--1 { border-radius: 50%; } .member__photo--2 { border-radius: 50% 50% 0 50%; }
  .member__role { color: var(--pink-text); font-weight: 600; margin-bottom: 8px; }
  .member__bio { color: var(--text-soft); max-width: 32ch; margin-inline: auto; }
  @media (min-width: 800px) { .team { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .principles { display: grid; gap: 20px; }
  .principles li { background: var(--white); border-radius: var(--r); padding: 26px 24px; }
  .principles h3 { font-size: 1.2rem; margin-bottom: 6px; }
  .principles p { color: var(--text-soft); margin: 0; }
  @media (min-width: 700px) { .principles { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .principles { grid-template-columns: repeat(3, 1fr); } }
  .oath { position: relative; margin: clamp(56px, 7vw, 88px) auto 0; max-width: 860px; padding: clamp(36px, 5vw, 56px); background: var(--white); border-radius: var(--r-lg); border-top-left-radius: 4px; text-align: center; }
  .oath__fairy { width: 90px; height: auto; margin: -80px auto 12px; }
  .oath p { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); line-height: 1.6; color: var(--navy); }
  .oath footer { margin-top: 18px; color: var(--pink-text); font-weight: 600; }
</style>
