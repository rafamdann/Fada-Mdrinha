---
/**
 * Faixa decorativa no topo de todas as páginas: um pequeno céu nocturno, sem texto.
 * Brilhos espalhados à mão (posição, altura e tamanho diferentes) e alguns pontinhos ao fundo.
 * Os marcados com `wide` só aparecem em ecrãs largos, para o telemóvel não ficar cheio.
 */
import Star from './Star.astro';
const stars = [
  { x: 4, y: 30, s: 10, c: '#fff', t: 0.2 },
  { x: 13, y: 68, s: 7, c: 'var(--gold)', t: 1.4, wide: true },
  { x: 21, y: 22, s: 13, c: 'var(--gold)', t: 0.7 },
  { x: 33, y: 62, s: 8, c: 'var(--pink)', t: 1.9, wide: true },
  { x: 41, y: 26, s: 9, c: '#fff', t: 1.1 },
  { x: 52, y: 70, s: 12, c: 'var(--blue)', t: 0.4, wide: true },
  { x: 60, y: 20, s: 8, c: 'var(--pink)', t: 1.6 },
  { x: 71, y: 58, s: 14, c: '#fff', t: 0.9, wide: true },
  { x: 80, y: 28, s: 7, c: 'var(--gold)', t: 2.1 },
  { x: 89, y: 64, s: 11, c: 'var(--pink)', t: 0.5, wide: true },
  { x: 96, y: 24, s: 9, c: 'var(--blue)', t: 1.3 },
];
const dots = [
  { x: 8, y: 72 }, { x: 17, y: 40 }, { x: 27, y: 80 }, { x: 37, y: 30 }, { x: 46, y: 76 },
  { x: 56, y: 42 }, { x: 66, y: 26 }, { x: 76, y: 82 }, { x: 85, y: 44 }, { x: 93, y: 78 },
];
---
<div class="announce" aria-hidden="true">
  {dots.map((d, i) => <span class:list={['announce__dot', { 'announce__wide': i % 2 === 1 }]} style={`left:${d.x}%;top:${d.y}%`}></span>)}
  {stars.map((st) => <Star class={st.wide ? 'announce__wide' : undefined} style={`left:${st.x}%;top:${st.y}%;--s:${st.s}px;--t:${st.t}s;margin:calc(var(--s) / -2) 0 0 calc(var(--s) / -2)`} color={st.c} />)}
</div>

<style>
  .announce { position: relative; overflow: hidden; height: 46px; background: var(--navy); }
  .announce__dot { position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff; opacity: 0.45; }
  .announce :global(.announce__wide) { display: none; }
  @media (min-width: 760px) { .announce :global(.announce__wide) { display: block; } }
</style>
