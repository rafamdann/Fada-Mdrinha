---
/** Faixa decorativa no topo de todas as páginas: os dois brilhos da versão 1, sem texto. */
import Star from './Star.astro';
---
<div class="announce" aria-hidden="true">
  <div class="wrap announce__inner">
    <Star style="position:relative;--s:14px;--t:.2s" color="var(--gold)" />
    <Star style="position:relative;--s:14px;--t:1.1s" color="var(--pink)" />
  </div>
</div>

<style>
  .announce { background: var(--navy); }
  .announce__inner { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 42px; padding-block: 8px; }
</style>
